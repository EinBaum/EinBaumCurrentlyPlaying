#version 460

// Half-resolution wash shadow term. One invocation per half-res texel reconstructs the card-plane
// world point it covers, PCF-filters the rasterized occlusion (R = key, G = tip light),
// and stores visibilities. The M_WASH fragment path then bilinearly upsamples this. The shadow
// term is low-frequency (soft penumbra, smooth tip pools), so the visible gradient survives the
// 2x downsample.

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D outShadow;
layout(set = 0, binding = 1) uniform sampler2D occShadow;

#include "shadow_common.glsl"   // Camera (set 1, binding 0), worldToWashUv, SHADOW_PCF_RADIUS

const float KEY_SHADOW_HARDNESS = 0.95;

const vec2 J[8] = vec2[](
    vec2( 0.40,  0.0),  vec2(-0.40,  0.0),  vec2( 0.0,  0.40),  vec2( 0.0, -0.40),
    vec2( 0.64,  0.64), vec2(-0.64,  0.64), vec2( 0.64, -0.64), vec2(-0.64, -0.64));

vec3 filterOcc(vec2 world, float radius) {
    vec3 acc = vec3(0.0);
    for (int i = 0; i < 8; i++)
        acc += textureLod(occShadow, worldToWashUv(world + J[i] * radius), 0.0).rgb;
    return acc * 0.125;
}

// A tip light casts no shadow when it is off or the receiver is out of its range; the fragment path
// early-outs identically there, so the stored value is unused but kept at fully-lit.
float tipVisibility(vec3 P, vec4 light, vec4 color, float shVis) {
    if (color.a <= 0.0) return 1.0;
    vec3 toL = light.xyz - P;
    if (length(toL) >= light.w) return 1.0;
    return shVis;
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(outShadow);
    if (gid.x >= dim.x || gid.y >= dim.y) return;

    // Texel centre in screen UV, then to the card-plane world point. The card maps edge-to-edge:
    // worldX in [-1, 1] across u, worldY in [+halfH, -halfH] across v (screen y down, world y up).
    vec2 uv = (vec2(gid) + 0.5) / vec2(dim);
    float halfH = max(cam.params.y, 1e-4);
    vec3 P = vec3(uv.x * 2.0 - 1.0, halfH * (1.0 - 2.0 * uv.y), 0.0);

    vec3 occ = filterOcc(P.xy, SHADOW_PCF_RADIUS);
    float keyVis = 1.0 - KEY_SHADOW_HARDNESS * (1.0 - occ.r);
    float tip1 = tipVisibility(P, cam.tipLight, cam.tipColor, occ.g);
    imageStore(outShadow, gid, vec4(keyVis, tip1, 1.0, 1.0));
}
